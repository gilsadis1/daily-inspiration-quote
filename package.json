{
  "name": "daily-inspiration-quote",
  "version": "1.0.0",
  "description": "Daily inspirational quote email in Hebrew",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "next build",
    "start": "next start",
    "dev": "next dev",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start:worker": "node dist/main.js",
    "start:vision-email": "node dist/oneOffVisionEmail.js",
    "dev:worker": "tsx src/main.ts",
    "dev:vision-email": "tsx src/oneOffVisionEmail.ts",
    "check-config": "tsx src/checkConfig.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^16.4.5",
    "next": "^16.2.6",
    "nodemailer": "^6.9.16",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.3"
  }
}
